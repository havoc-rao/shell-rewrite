{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "shr: build",
      "detail": "make build  (产物输出到 dist/shr)",
      "type": "shell",
      "command": "make",
      "args": ["build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "shr: install",
      "detail": "make install  (go install 到 $GOPATH/bin)",
      "type": "shell",
      "command": "make",
      "args": ["install"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
